# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:root@localhost:5432/fintrack_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/fintrack_db

# CORS Configuration (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# V1 Single-User System Fallback User UUID
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# JWT & Authentication Security (100% Environment Driven)
JWT_SECRET_KEY=change_this_to_a_secure_high_entropy_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


# Cookie Security Settings
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Rate Limiting Configuration
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_RESET=3/minute

# Email Service Configuration (Pluggable: smtp | resend | console)
EMAIL_PROVIDER=smtp
EMAIL_FROM="FinTrack <your_email@gmail.com>"
FRONTEND_URL=http://localhost:3000

# Local / Real SMTP Configuration Settings
# For Gmail SMTP:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_16_digit_gmail_app_password
#   SMTP_TLS=True
# For Mailtrap / Local SMTP test server:
#   SMTP_HOST=sandbox.smtp.mailtrap.io (or localhost)
#   SMTP_PORT=2525 (or 1025)
#   SMTP_USER=your_mailtrap_user
#   SMTP_PASSWORD=your_mailtrap_password
#   SMTP_TLS=True (or False for localhost)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_TLS=True
SMTP_SSL=False

# Resend API Configuration (Production)
RESEND_API_KEY=re_your_resend_api_key_here

# Pluggable AI Recommendation Service (gemini | openai | rule_based)
AI_PROVIDER=gemini
AI_ENABLED=True

# Google Gemini API Settings (Get free API key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI / ChatGPT API Settings (Future / Alternative: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini


# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL with local credentials)
DATABASE_URL=postgresql://postgres:root@localhost:5432/fintrack_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/fintrack_db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# V1 Single-User System User UUID (Defaulted)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
